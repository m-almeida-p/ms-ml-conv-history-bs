SELECT event_name = $3 AND event_version = $4 AND payload = $5::jsonb AND metadata = $6::jsonb
       AND correlation_id IS NOT DISTINCT FROM $7
       AND id_yape_account IS NOT DISTINCT FROM $8
       AND actor IS NOT DISTINCT FROM $9
       AND flow IS NOT DISTINCT FROM $10 AS same
FROM conversation_inbox
WHERE 1=1
  AND conversation_id = $1
  AND sequence = $2

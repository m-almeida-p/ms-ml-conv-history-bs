POSTGRES_PASSWORD=postgres

# Which schema the API reads. The default (config.yaml) is history: the tables the new Camel consumer
# (ms-ml-conv-history-consumer) fills. To read the old consumer's tables (ms-ml-camel-conv-history-bs) instead,
# uncomment the next line, then restart: ./scripts/run_api.sh --rebuild. Both schemas hold the same messages.
# Comment it out again, or set it to history, to go back. An empty value keeps the database user's own search_path.
# POSTGRES_SEARCH_PATH=camel_history

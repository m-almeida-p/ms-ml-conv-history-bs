/api
/bin/

# Test and coverage output
coverage.out
coverage

# Local run scripts (scripts/run_*.sh): their logs and pid files
*.log
*.pid
scripts/logs/

# .env holds only the local development values (the local database password, the schema) and is committed.
# Any other .env.* file stays out, so a real environment's settings are never committed by accident.
.env.*
!.env.example

.idea/
.DS_Store
